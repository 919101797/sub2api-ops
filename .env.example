# Docker 部署模板。所有 replace-with 值必须替换；真实 .env 不提交。
SUB2API_BASE_URL=http://sub2api:8080/api/v1
SUB2API_ADMIN_API_KEY=replace-with-admin-api-key
SUB2API_DB_HOST=replace-with-database-host
SUB2API_DB_PORT=5432
SUB2API_DB_NAME=sub2api
SUB2API_DB_USER=replace-with-read-only-user
SUB2API_DB_PASSWORD=replace-with-read-only-password
PROMPT_AUDIT_DB_USER=sub2api_ops_writer
PROMPT_AUDIT_DB_PASSWORD=replace-with-audit-password
PROMPT_CAPTURE_SECRET=replace-with-at-least-32-characters-secret
PROMPT_MEDIA_PATH=/data/prompt-media
WS_RELAY_UPSTREAM_ORIGIN=ws://sub2api:8080
SUB2API_DOCKER_NETWORK=sub2api_default
OPS_HOST_PORT=3002
WS_RELAY_HOST_PORT=3003
TZ=Asia/Shanghai
SESSION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
PUBLIC_ORIGIN=https://sub2api.example.com
COOKIE_PATH=/ops
COOKIE_SECURE=true
