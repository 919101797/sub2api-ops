[Unit]
Description=Sub2API restricted runtime settings controller
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=1000
ExecStart=/usr/bin/python3 /usr/local/lib/sub2api-runtime-control/controller.py
Environment=DOCKER_CONFIG=/var/lib/sub2api-runtime-control/docker
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Restart=on-failure
RestartSec=5
StateDirectory=sub2api-runtime-control
StateDirectoryMode=0750
UMask=0027
MemoryAccounting=true
MemoryMax=128M
CPUQuota=20%
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sub2api
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET
TimeoutStopSec=170

[Install]
WantedBy=multi-user.target
